{
  "name": "pwm",
  "version": "0.0.0",
  "scripts": {
    "ng": "pwm/node_modules/.bin/ng",
    "start": "pwm/node_modules/.bin/ng serve",
    "build": "pwm/node_modules/.bin/ng build",
    "watch": "pwm/node_modules/.bin/ng build --watch --configuration development",
    "test": "pwm/node_modules/.bin/ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@ionic/angular": "^8.8.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.24",
    "@angular/cli": "^20.3.24",
    "@angular/compiler-cli": "^20.3.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "@ionic/angular-toolkit": "latest"
  }
}